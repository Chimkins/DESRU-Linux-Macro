cat > .gitignore <<'EOF'
# Python-generated files
__pycache__/
*.py[cod]

# Build / packaging
build/
dist/
*.egg-info/
wheels/

# Virtual environment
.venv/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment / secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
EOF
